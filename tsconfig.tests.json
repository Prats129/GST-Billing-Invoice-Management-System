{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "jsx": "react-jsx",
    "types": ["node"]
  },
  "include": [
    "apps/**/*.test.ts",
    "packages/**/*.test.ts",
    "tests/**/*.ts",
    "scripts/issuer/**/*.ts",
    "scripts/setup/**/*.ts",
    "vitest.config.ts",
    "playwright.config.ts"
  ],
  "exclude": ["node_modules", "**/dist"]
}
