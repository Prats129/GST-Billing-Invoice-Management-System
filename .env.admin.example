# Copy to .env.admin. Keep credentials private; never reuse the customer runtime DB role.
PLATFORM_DATABASE_URL=postgresql://platform_runtime:REPLACE_PASSWORD@127.0.0.1:5432/gst_platform_dev
# Put this ONLY in .env.admin.operator, never in the running API environment:
# PLATFORM_MIGRATION_DATABASE_URL=postgresql://platform_operator:REPLACE_PASSWORD@127.0.0.1:5432/gst_platform_dev
PLATFORM_AUTH_KEY=REPLACE_WITH_64_PRIVATE_HEX_CHARACTERS
PLATFORM_ORIGIN=http://127.0.0.1:5174
PLATFORM_HOST=127.0.0.1
PLATFORM_PORT=3001
# Optional until a SaaS environment exists. Use the restricted EXECUTE-only role.
# SAAS_OPERATOR_DATABASE_URL=postgresql://saas_operator:REPLACE_PASSWORD@127.0.0.1:5432/gst_saas_dev
# SAAS_MIGRATION_DATABASE_URL=postgresql://saas_migrator:REPLACE_PASSWORD@127.0.0.1:5432/gst_saas_dev
# SAAS_APP_ORIGIN=http://127.0.0.1:5173
# Optional read-only diagnostic comparison. Independently verify the target first.
# This does not change the connection or enable/disable operations.
# SAAS_EXPECTED_DATABASE_NAME=gst_saas_dev
# PLATFORM_TRUST_FILE=C:/Publisher-private/public-trust.json
# NODE_ENV=production
# PLATFORM_TLS_KEY=C:/Publisher-private/tls.key
# PLATFORM_TLS_CERT=C:/Publisher-private/tls.pem
# PLATFORM_WEB_ROOT=E:/GST-Billing-Invoice-Management-System/apps/admin/dist
