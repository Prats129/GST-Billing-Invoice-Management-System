# Copy to .env; replace placeholders with a unique local-development password.
# Percent-encode reserved password characters in URL values.
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_LOCAL_PASSWORD
DATABASE_URL=postgresql://gst_dev:REPLACE_WITH_RANDOM_LOCAL_PASSWORD@127.0.0.1:5432/gst_dev
MIGRATION_DATABASE_URL=postgresql://gst_dev:REPLACE_WITH_RANDOM_LOCAL_PASSWORD@127.0.0.1:5432/gst_dev
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
APP_ORIGIN=http://localhost:5173
ALLOWED_HOSTS=localhost:3000,127.0.0.1:3000,localhost:5173,127.0.0.1:5173
DEPLOYMENT_EDITION=offline
# Optional only for TLS/static deployment:
# TLS_KEY_PATH=C:/GST/tls/server.key
# TLS_CERT_PATH=C:/GST/tls/server-chain.crt
# WEB_ROOT=E:/GST-Billing-Invoice-Management-System/apps/web/dist
# Integration command must explicitly set TEST_DATABASE_ADMIN_URL; never production.
