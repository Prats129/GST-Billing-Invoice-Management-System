{
  "name": "gst-billing-platform",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=24.22.1 <25",
    "pnpm": "10.34.9"
  },
  "scripts": {
    "bundle:prepare": "pnpm build && tsx scripts/issuer/windows-bundle-cli.ts prepare",
    "bundle:seal": "pnpm build:packages && tsx scripts/issuer/windows-bundle-cli.ts seal",
    "bundle:verify": "tsx scripts/issuer/windows-bundle-cli.ts verify",
    "bundle:smoke": "tsx scripts/issuer/windows-bundle-cli.ts smoke",
    "bundle:launcher": "tsx scripts/issuer/windows-launcher-cli.ts",
    "signing:internal": "powershell.exe -NoLogo -NoProfile -File scripts/issuer/Internal-WindowsSigning.ps1",
    "setup:env": "node scripts/setup-env.mjs",
    "setup:prepare": "powershell.exe -NoProfile -File scripts/Setup-Project.ps1",
    "setup:guided": "tsx scripts/setup/cli.ts",
    "setup:launch": "tsx scripts/setup/cli.ts --launch",
    "setup:check": "tsx scripts/setup-check.ts",
    "identity:host": "pnpm build:packages && tsx apps/api/src/security/host-cli.ts",
    "smoke": "node --env-file=.env scripts/smoke.mjs",
    "dev": "pnpm build:packages && concurrently -k -n api,web \"pnpm --filter @gst/api dev\" \"pnpm --filter @gst/web dev\"",
    "build:packages": "pnpm --filter @gst/security --filter @gst/contracts --filter @gst/database --filter @gst/billing-engine --filter @gst/invoice-renderer -r build",
    "build": "pnpm build:packages && pnpm --filter @gst/api --filter @gst/web --filter @gst/admin-api --filter @gst/admin -r build",
    "start": "node apps/api/dist/main.js",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm build:packages && pnpm -r typecheck && tsc -p tsconfig.tests.json",
    "test": "pnpm build:packages && vitest run --project unit",
    "test:integration": "pnpm build:packages && vitest run --project integration",
    "test:e2e": "playwright test",
    "db:generate": "pnpm --filter @gst/database db:generate",
    "db:migrate": "pnpm --filter @gst/database db:migrate",
    "db:schema": "tsx packages/database/src/schema-cli.ts",
    "recovery:runtime": "tsx packages/database/src/runtime-access-cli.ts",
    "recovery:switch": "tsx packages/database/src/recovery-switch-cli.ts",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "backup": "tsx packages/database/src/backup-cli.ts",
    "backup:health": "tsx packages/database/src/backup-health-cli.ts",
    "backup:guided": "pnpm build:packages && tsx scripts/operations/cli.ts",
    "license:install": "pnpm build:packages && tsx apps/api/src/licensing/host-cli.ts",
    "license:issue": "pnpm build:packages && tsx scripts/issuer/entitlement-cli.ts",
    "license:register": "pnpm build:packages && tsx scripts/issuer/register-cli.ts",
    "tls:certificate": "pnpm build:packages && tsx apps/api/src/operations/certificate-cli.ts",
    "offline:host": "pnpm build:packages && pnpm --filter @gst/api build && tsx apps/api/src/operations/offline-install-cli.ts",
    "release:verify": "tsx apps/api/src/operations/release-cli.ts",
    "release:eligibility": "pnpm build:packages && tsx apps/api/src/operations/update-eligibility-cli.ts",
    "release:stage": "tsx apps/api/src/operations/release-stage-cli.ts",
    "release:sign": "pnpm build:packages && tsx scripts/issuer/release-cli.ts",
    "dev:admin": "pnpm build:packages && concurrently -k -n admin-api,admin \"pnpm --filter @gst/admin-api dev\" \"pnpm --filter @gst/admin dev\"",
    "admin:db:migrate": "pnpm build:packages && pnpm --filter @gst/admin-api db:migrate",
    "admin:owner": "pnpm build:packages && pnpm --filter @gst/admin-api owner",
    "start:admin": "node apps/admin-api/dist/main.js"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "^22.19.0",
    "@types/supertest": "^6.0.3",
    "concurrently": "^9.2.1",
    "eslint": "10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.5.0",
    "prettier": "^3.6.2",
    "supertest": "^7.1.4",
    "tsx": "^4.20.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5",
    "zod": "4.6.7"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "argon2",
      "@nestjs/core"
    ]
  }
}
